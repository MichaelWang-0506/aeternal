  m_Name: Zeus Encounter
  m_EditorClassIdentifier: Assembly-CSharp::Aeternal.Encounters.EncounterData
  encounterId: zeus
  displayName: Zeus
  isBoss: 1
  isElite: 0
  stats: {fileID: 11400000, guid: cb71016ce4054d65a01d44a14f415e37, type: 2}
  baseDamage: 4
