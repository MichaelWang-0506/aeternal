  chargedAttackName: THUNDERBOLT
  chargeWarning: "Zeus gathers the storm. Next round, every square but one is struck!"
  chargeRelease: "Only one square is safe. Move!"
  introDialogue:
  - speaker: ""
    text: "At the summit, the clouds part. The king of the gods waits on a throne of lightning."
  - speaker: "Zeus"
    text: "So. The mortal who mocked Death, crawling back through my lands with half a deck and no blessing."
  - speaker: "The Ruler"
    text: "I mastered Chronus's gift once. I will master yours."
  - speaker: "Zeus"
    text: "Then prove it. Weather the storm."
