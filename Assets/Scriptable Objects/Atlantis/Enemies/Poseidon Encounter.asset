  terrainName: CORAL WALL
  terrainWarning: "Coral bursts from the sea floor beside you. You can't step there."
  chargedAttackEvery: 3
  chargedAttackMultiplier: 2
  chargedAttackName: TIDAL WAVE
  chargeTitle: THE TIDE RISES
  chargeWarning: "The sea pulls back. Next round a wave crashes over every square but one!"
