  introDialogue:
  - speaker: ""
    text: "At the heart of the sunken city, a throne of coral. The lord of the sea rises from it."
  - speaker: "Poseidon"
    text: "My brother let you climb his mountain. The sea is not so forgiving."
  - speaker: "The Ruler"
    text: "I took his thunder. I will take your tide."
  - speaker: "Poseidon"
    text: "Then drown trying."
