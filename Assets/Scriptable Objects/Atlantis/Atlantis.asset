  - {fileID: 11400000, guid: f59999f0dc705212ac91001bae5f95ef, type: 2}
  - {fileID: 11400000, guid: 42720ee6a19a590dbc0609ef2f597775, type: 2}
  blessingNarrative:
  - speaker: "Poseidon"
    text: "You hold your breath well, mortal. Very well. Even the sea must give way to some things."
  - speaker: "Poseidon"
    text: "Take my blessing, and the tide with it. Build your walls; drown your enemies in them."
  - speaker: ""
    text: "The Tide Pearls the ruler had gathered glow, and the sea answers him."
  blessingTitle: Blessing of Poseidon
  regionEvent:
    enabled: 1
    afterEncounter: 1
    title: Drowned Shrine
    text: "A shrine to Poseidon stands half-buried in sand, its offering bowl still full of pearls. The water around it is warm."
    healAmount: 8
    shardChoices: 3
