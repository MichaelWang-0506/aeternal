  onRegionClearedScene: MainMenu
  showMap: 1
  nextMap: {fileID: 0}
  keepsProgress: 1
  openingNarrative:
  - speaker: ""
    text: "The storm broke, and the ruler fell with the rain, down through the clouds and into the sea."
  - speaker: ""
    text: "Beneath the waves lay a city he knew: his own harbour capital, sunk long ago, now Atlantis, the realm of Poseidon."
  - speaker: ""
    text: "Zeus's thunder answers him now. When the fight turns, Shift to the Zeus deck (Z, or the button by your Divine Focus)."
  - speaker: ""
    text: "Poseidon waits at the heart of the city. Gather the Tide Pearls on the way; his blessing will wake them."
  blessingDeck: {fileID: 11400000, guid: 4a33bc1b92bc588d8609640863b69bc1, type: 2}
  stormShardPool:
  - {fileID: 11400000, guid: 62dcb6a16ee7540a9f8b7e544f7f9781, type: 2}
