  openingNarrative:
  - speaker: ""
    text: "Darkness. Then dusty air, heavy and familiar. The ruler awoke in a ruined temple, alive again, decades after his death."
  - speaker: ""
    text: "His empire had fallen. His strength was gone. Of everything he once commanded, only a battered handful of cards remained."
  - speaker: ""
    text: "Above the ruins rose the storm-torn peaks of Zeusonia. The god of thunder had claimed the ruler's old lands as his own."
  - speaker: ""
    text: "To break the loop, he must climb, and take back the power of the gods one blessing at a time."
  blessingDeck: {fileID: 11400000, guid: 8975974613b6493283f7b0cb14e8068b, type: 2}
  stormShardPool:
  - {fileID: 11400000, guid: 41defe8de1ffb47aaa16304337531c5b, type: 2}
  - {fileID: 11400000, guid: 1068e2d6e439d421b80f8955b7c32b34, type: 2}
  - {fileID: 11400000, guid: 154d8a1c911564cb8b1e3ca6ed063b0d, type: 2}
  - {fileID: 11400000, guid: 36e19c5f7f3e341dfa261ce9ab5eb00f, type: 2}
  - {fileID: 11400000, guid: 158c35f1f8d9d4df38ef5e7a5262ec91, type: 2}
  blessingNarrative:
  - speaker: "Zeus"
    text: "Enough! You fight like a storm yourself, mortal. Chronus chose well."
  - speaker: "Zeus"
    text: "Take my blessing, and with it my thunder. Let us see what you make of it."
  - speaker: ""
    text: "The Storm Shards the ruler had gathered on the climb crackle to life."
  blessingTitle: Blessing of Zeus
  regionEvent:
    enabled: 1
    afterEncounter: 1
    title: Storm Altar
    text: "Halfway up the mountain stands an altar to Zeus, scorched black by a thousand lightning strikes. It still hums with power."
    healAmount: 8
    shardChoices: 3
