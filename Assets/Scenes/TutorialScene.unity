  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Status effects can be put on you or on the enemy. For example:\n- <b>Bleed</b>: deals damage at the end of each round\n- <b>Stun / Blackout</b>: the target skips its next action\n- <b>Dodge</b>: cancels the next attack against you\n\nYour effects show in your stats panel; the enemy's show in theirs."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
